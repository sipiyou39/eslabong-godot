; Engine configuration file.
config_version=5

[application]

config/name="ArenaBattler"
config/description="ArenaBattler - club de mercenaires et arène tactique 3D en temps réel (PC et mobile)"
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[rendering]

renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.03, 0.025, 0.04, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
scaling_3d/scale=1.0
environment/ssao/quality=2
environment/glow/upscale_mode=1

[gui]

theme/default_font_antialiasing=2

[autoload]

Data="*res://src/autoload/Data.gd"
Settings="*res://src/autoload/Settings.gd"
Audio="*res://src/autoload/Audio.gd"
Game="*res://src/autoload/Game.gd"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
